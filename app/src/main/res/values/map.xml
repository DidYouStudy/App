<resources>
    <!-- Where the camera first looks: the centre of the EPFL campus. Read by GroupSessionMapView
         and GroupSessionMapContent. -->
    <item name="map_campus_center_latitude" type="dimen" format="float">46.5191</item>
    <item name="map_campus_center_longitude" type="dimen" format="float">6.5668</item>

    <!-- Zoom levels: close enough to see the campus buildings, and close enough to a room when
         the camera moves to it. -->
    <item name="map_default_zoom" type="dimen" format="float">16.5</item>
    <item name="map_focus_zoom" type="dimen" format="float">17</item>

    <!-- Duration of the camera animation to a new target, in milliseconds. -->
    <integer name="map_camera_animation_ms">600</integer>

    <!-- Timeout waiting for map projection to become ready, in milliseconds. -->
    <integer name="map_projection_timeout_ms">2000</integer>

    <!-- Polling interval when waiting for map projection, in milliseconds. -->
    <integer name="map_projection_poll_interval_ms">50</integer>

    <!-- Largest share of the screen height taken by the list of sessions opened from a pin. -->
    <item name="map_session_list_max_height_fraction" type="dimen" format="float">0.45</item>

    <!-- Angles, in degrees, used to draw the pin's outline. -->
    <integer name="map_quarter_turn_degrees">90</integer>
    <integer name="map_full_turn_degrees">360</integer>

    <!-- Opacity of the fill inside the distance-filter radius circle. -->
    <item name="map_filter_radius_fill_alpha" type="dimen" format="float">0.14</item>

    <!-- Mean Earth radius in metres and minimum cosine of latitude for circle bounds. -->
    <item name="map_earth_radius_meters" type="dimen" format="float">6371000.0</item>
    <item name="map_min_cos_latitude" type="dimen" format="float">0.000001</item>

    <!-- Center anchor fraction (0..1) for the filter-radius pill marker. -->
    <item name="map_center_anchor" type="dimen" format="float">0.5</item>
</resources>
