<resources>
    <!-- Longest side, in pixels, of the stored profile picture. Plenty for an avatar, and it keeps
         the file to a few dozen KB, far below the 1 MB limit set in storage.rules. Read by
         AndroidImageCompressor. -->
    <integer name="profile_picture_max_edge_px">512</integer>

    <!-- JPEG quality from 0 to 100 used when re-encoding the picture. Read by
         AndroidImageCompressor. -->
    <integer name="profile_picture_jpeg_quality">85</integer>
</resources>
