// Co-authored-by: OpenAI Codex <noreply@openai.com>
// Co-authored-by: Claude Opus 5.5
// Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
//
// Cloud Firestore security rules. This file is the source of truth: deploy it with
// `firebase deploy --only firestore:rules` instead of editing rules in the console, or the next
// deploy silently overwrites the console changes. The Firestore emulator loads it too.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Documents keyed by the Firebase Auth uid belong to that user only.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      // Everything in a profile is readable by signed-in users; do not store private data here.
      allow get: if request.auth != null;
      allow write: if isOwner(userId);
    }

    match /preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Top-level schema checks complement the domain mapper's nested task validation.
    function optionalText(data, field, nonblank) {
      return data.get(field, null) == null
        || (data[field] is string && (!nonblank || data[field].matches('.*[^\\s].*')));
    }

    function validEvent(userId) {
      let d = request.resource.data;
      return d.keys().hasAll(['ownerId', 'type', 'startsAt', 'endsAt', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['ownerId', 'type', 'subject', 'startsAt', 'endsAt',
                            'createdAt', 'updatedAt', 'location', 'description', 'tasks',
                            'importKey'])
        && d.ownerId == userId
        && d.type in ['STUDY_SESSION', 'COURSE', 'EXERCISE_SESSION', 'LAB', 'PROJECT', 'EXAM', 'OTHER']
        && optionalText(d, 'subject', true)
        && (d.type == 'OTHER' || d.get('subject', null) != null)
        && optionalText(d, 'location', true)
        && optionalText(d, 'description', false)
        && optionalText(d, 'importKey', true)
        && d.startsAt is timestamp && d.endsAt is timestamp
        && d.endsAt > d.startsAt && d.endsAt - d.startsAt <= duration.value(24, 'h')
        && d.createdAt is timestamp && d.updatedAt is timestamp
        && d.get('tasks', []) is list;
    }

    match /users/{userId}/events/{eventId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validEvent(userId);
    }

    // Dynamic map entries and task list members are validated by the Android mapper, not
    // exhaustively by rules. These are private owner-controlled values, never shared data.
    match /users/{userId}/meta/subjects {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['subjects'])
        && request.resource.data.subjects is map;
    }

    // Checks the complete stored schema and schedule constraints for a shared session.
    function validGroupSession() {
      let d = request.resource.data;
      return d.keys().hasAll(['createdBy', 'memberIds', 'type', 'startsAt', 'endsAt',
                              'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['createdBy', 'memberIds', 'type', 'subject', 'startsAt',
                             'endsAt', 'createdAt', 'updatedAt', 'location', 'description'])
        && optionalText(d, 'createdBy', true)
        && d.memberIds is list
        && d.memberIds.size() >= 1 && d.memberIds.size() <= 30
        && d.memberIds.toSet().size() == d.memberIds.size()
        && d.createdBy in d.memberIds
        && d.type is string
        && d.type in ['STUDY_SESSION', 'COURSE', 'EXERCISE_SESSION', 'LAB', 'PROJECT', 'EXAM', 'OTHER']
        && optionalText(d, 'subject', true)
        && (d.type == 'OTHER' || d.get('subject', null) != null)
        && optionalText(d, 'location', true)
        && optionalText(d, 'description', false)
        && d.startsAt is timestamp && d.endsAt is timestamp
        && d.endsAt > d.startsAt && d.endsAt - d.startsAt <= duration.value(24, 'h')
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    // Allows a non-creator to toggle only their own membership without touching other data.
    function canChangeOwnMembership(userId) {
      let before = resource.data.memberIds.toSet();
      let after = request.resource.data.memberIds.toSet();
      return userId != resource.data.createdBy
        && resource.data.memberIds is list
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 1
        && request.resource.data.memberIds.size() <= 30
        && after.size() == request.resource.data.memberIds.size()
        && after.difference(before).hasOnly([userId])
        && before.difference(after).hasOnly([userId])
        && request.resource.data.memberIds.hasAny([userId])
             != resource.data.memberIds.hasAny([userId])
        && (!request.resource.data.memberIds.hasAny([userId]) || resource.data.endsAt > request.time)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']);
    }

    match /groupSessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && validGroupSession()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow update: if request.auth != null
        && validGroupSession()
        && (
          (resource.data.createdBy == request.auth.uid
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt)
          || canChangeOwnMembership(request.auth.uid)
        );
      allow delete: if request.auth != null && (resource == null || resource.data.createdBy == request.auth.uid);
    }

    // Anything not matched above is denied by default.
  }
}
