// Co-authored-by: OpenAI Codex <noreply@openai.com>
// Co-authored-by: Claude Opus 5.5
// Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
//
// Cloud Firestore security rules. This file is the source of truth: deploy it with
// `firebase deploy --only firestore:rules` instead of editing rules in the console, or the next
// deploy silently overwrites the console changes. The Firestore emulator loads it too.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Documents keyed by the Firebase Auth uid belong to that user only.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // A username is valid when it follows UsernamePolicy.kt (keep both in sync).
    function validUsername(name) {
      return name is string && name.matches('[A-Za-z0-9][A-Za-z0-9_.-]{2,19}');
    }

    // True when, after the write, usernames/{lowercase name} exists and belongs to userId. Used
    // so a profile can only carry a username its owner has reserved.
    function ownsUsernameAfter(userId, name) {
      return validUsername(name)
        && existsAfter(/databases/$(database)/documents/usernames/$(name.lower()))
        && getAfter(/databases/$(database)/documents/usernames/$(name.lower())).data.uid == userId;
    }

    match /profiles/{userId} {
      // Everything in a profile is readable by signed-in users; do not store private data here.
      allow get: if request.auth != null;
      // A profile may start without a username; a non-blank one must be reserved by its owner.
      allow create: if isOwner(userId)
        && (request.resource.data.get('username', '') == ''
            || ownsUsernameAfter(userId, request.resource.data.username));
      // Other fields (for example the avatar) can change freely; a changed username must be
      // reserved by its owner in the same transaction.
      allow update: if isOwner(userId)
        && (request.resource.data.get('username', '') == resource.data.get('username', '')
            || ownsUsernameAfter(userId, request.resource.data.get('username', '')));
      allow delete: if isOwner(userId);
    }

    // One reservation per lowercase username, created and released by its owner in the same
    // transaction as the profile update. Reservations are never updated, and can be fetched by
    // name but not listed.
    match /usernames/{key} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && key.matches('[a-z0-9][a-z0-9_.-]{2,19}')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Named limits shared by several rules. Keep them in sync with the Kotlin constants named in
    // each comment.
    // EventType.kt
    function eventTypes() {
      return ['STUDY_SESSION', 'COURSE', 'EXERCISE_SESSION', 'LAB', 'PROJECT', 'EXAM', 'OTHER'];
    }
    function maxEventDuration() {
      return duration.value(24, 'h');
    }
    // GroupSession.MAX_MEMBERS
    function maxMembers() {
      return 30;
    }
    // EventTextLimits.SUBJECT, LOCATION and DESCRIPTION
    function maxSubjectLength() {
      return 100;
    }
    function maxLocationLength() {
      return 100;
    }
    function maxDescriptionLength() {
      return 500;
    }

    // Top-level schema checks complement the domain mapper's nested task validation.
    function optionalText(data, field, nonblank) {
      return data.get(field, null) == null
        || (data[field] is string && (!nonblank || data[field].matches('.*[^\\s].*')));
    }

    // Like optionalText, and a present value has at most maxLength characters.
    function boundedText(data, field, nonblank, maxLength) {
      return optionalText(data, field, nonblank)
        && (data.get(field, null) == null || data[field].size() <= maxLength);
    }

    function validEvent(userId) {
      let d = request.resource.data;
      return d.keys().hasAll(['ownerId', 'type', 'startsAt', 'endsAt', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['ownerId', 'type', 'subject', 'startsAt', 'endsAt',
                            'createdAt', 'updatedAt', 'location', 'description', 'tasks',
                            'importKey'])
        && d.ownerId == userId
        && d.type in eventTypes()
        && optionalText(d, 'subject', true)
        && (d.type == 'OTHER' || d.get('subject', null) != null)
        && optionalText(d, 'location', true)
        && optionalText(d, 'description', false)
        && optionalText(d, 'importKey', true)
        && d.startsAt is timestamp && d.endsAt is timestamp
        && d.endsAt > d.startsAt && d.endsAt - d.startsAt <= maxEventDuration()
        && d.createdAt is timestamp && d.updatedAt is timestamp
        && d.get('tasks', []) is list;
    }

    match /users/{userId}/events/{eventId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validEvent(userId);
    }

    // Dynamic map entries and task list members are validated by the Android mapper, not
    // exhaustively by rules. These are private owner-controlled values, never shared data.
    match /users/{userId}/meta/subjects {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['subjects'])
        && request.resource.data.subjects is map;
    }

    match /users/{userId}/meta/trackedSubjects {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['subjects'])
        && request.resource.data.subjects is map;
    }

    // Checks the complete stored schema and schedule constraints for a shared session. Every member
    // reads these values, so text lengths are bounded too.
    function validGroupSession() {
      let d = request.resource.data;
      return d.keys().hasAll(['createdBy', 'memberIds', 'type', 'startsAt', 'endsAt',
                              'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['createdBy', 'memberIds', 'type', 'subject', 'startsAt',
                             'endsAt', 'createdAt', 'updatedAt', 'location', 'description'])
        && optionalText(d, 'createdBy', true)
        && d.memberIds is list
        && d.memberIds.size() >= 1 && d.memberIds.size() <= maxMembers()
        && d.memberIds.toSet().size() == d.memberIds.size()
        && d.createdBy in d.memberIds
        && d.type is string
        && d.type in eventTypes()
        && optionalText(d, 'subject', true)
        && (d.type == 'OTHER' || d.get('subject', null) != null)
        && optionalText(d, 'location', true)
        && optionalText(d, 'description', false)
        && d.startsAt is timestamp && d.endsAt is timestamp
        && d.endsAt > d.startsAt && d.endsAt - d.startsAt <= maxEventDuration()
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    // Length limits, checked only on create and creator edit. Join and leave can change only
    // memberIds, so a stored session whose text predates the limits can still be joined and left.
    function validGroupSessionText() {
      let d = request.resource.data;
      return boundedText(d, 'subject', true, maxSubjectLength())
        && boundedText(d, 'location', true, maxLocationLength())
        && boundedText(d, 'description', false, maxDescriptionLength());
    }

    // Allows a non-creator to toggle only their own membership without touching other data.
    function canChangeOwnMembership(userId) {
      let before = resource.data.memberIds.toSet();
      let after = request.resource.data.memberIds.toSet();
      return userId != resource.data.createdBy
        && resource.data.memberIds is list
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 1
        && request.resource.data.memberIds.size() <= maxMembers()
        && after.size() == request.resource.data.memberIds.size()
        && after.difference(before).hasOnly([userId])
        && before.difference(after).hasOnly([userId])
        && request.resource.data.memberIds.hasAny([userId])
             != resource.data.memberIds.hasAny([userId])
        && (!request.resource.data.memberIds.hasAny([userId]) || resource.data.endsAt > request.time)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']);
    }

    match /groupSessions/{sessionId} {
      allow read: if request.auth != null;
      // The phone's clock is not trusted: creation and edit times must be the server's time, which
      // the app writes with FieldValue.serverTimestamp().
      allow create: if request.auth != null
        && validGroupSession()
        && validGroupSessionText()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Joining and leaving keep updatedAt unchanged (canChangeOwnMembership allows only memberIds).
      allow update: if request.auth != null
        && validGroupSession()
        && (
          (resource.data.createdBy == request.auth.uid
            && validGroupSessionText()
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time)
          || canChangeOwnMembership(request.auth.uid)
        );
      allow delete: if request.auth != null && (resource == null || resource.data.createdBy == request.auth.uid);
    }

    // Anything not matched above is denied by default.
  }
}
