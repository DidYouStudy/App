// Co-authored-by: Claude Sonnet 5.5 <noreply@anthropic.com>
//
// Cloud Storage security rules. This file is the source of truth: deploy it with
// `firebase deploy --only storage` instead of editing rules in the console, or the next deploy
// silently overwrites the console changes. The Storage emulator loads it too.
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // A user's profile picture lives in one of two objects, profilePictures/{userId}_a.jpg and
    // profilePictures/{userId}_b.jpg. The app uploads to the slot the profile does not point to, so
    // the current picture and its URL stay valid until the new URL is saved (replacing an object
    // invalidates its old URL). Like the profile document, any signed-in user can read them; only
    // the owner can create or replace them, and only with a JPEG under 1 MB (the app downscales far
    // below that). There is no delete rule yet: deleting is denied until a "remove picture" feature
    // needs it.
    match /profilePictures/{fileName} {
      // The upload itself needs this rule: getDownloadUrl() reads the object's metadata right after
      // the upload. Showing a picture does not: it is loaded from the tokenized download URL saved
      // in the profile, which bypasses these rules, so this rule does not control who can view it.
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && (fileName == request.auth.uid + '_a.jpg' || fileName == request.auth.uid + '_b.jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 1024 * 1024;
        //TODO: add rules for file deletion
    }

    // Anything not matched above is denied by default.
  }
}
